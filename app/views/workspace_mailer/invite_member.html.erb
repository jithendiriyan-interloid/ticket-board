<!DOCTYPE html>
<html>
  <body>
    <h2>You're Invited! 🎉</h2>
    <p>Hi <%= @membership.user.email %>,</p>
    <p>
      <strong><%= @invited_by.email %></strong> has invited you to join
      <strong><%= @workspace.name %></strong> workspace.
    </p>
    <%= link_to "Accept Invitation", @accept_url, style: "background:#2563eb;color:white;padding:10px 20px;border-radius:6px;text-decoration:none;" %>
  </body>
</html>