<div class="max-w-4xl mt-12 mx-auto p-6">
  <div class="bg-white rounded-2xl shadow-sm border border-gray-200">
    <div class="flex items-start justify-between border-b border-gray-200 p-6">
      <div>
        <p class="text-sm text-gray-500">Task</p>
        <h1 class="text-2xl font-bold text-gray-900"><%= @subtask.title %></h1>
      </div>
      <div class="flex items-center gap-2">
        <%= link_to edit_task_subtask_path(@task, @subtask), class: "inline-flex items-center gap-1.5 text-sm px-3 py-1.5 border border-slate-200 rounded-lg text-slate-700 hover:bg-slate-50 transition" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z"/>
          </svg>
          Edit
        <% end %>
        <%= link_to task_subtask_path(@task, @subtask), method: :delete, data: { turbo_method: :delete, confirm: "Delete this workspace?" }, class: "inline-flex items-center gap-1.5 text-sm px-3 py-1.5 border border-red-200 rounded-lg text-red-600 hover:bg-red-50 transition" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/>
          </svg>
          Delete
        <% end %>
      </div>
    </div>
    <div class="p-6 space-y-6">
      <% if @subtask.description.present? %>
        <div>
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Description</h3>
          <p class="text-gray-600 whitespace-pre-wrap"><%= @subtask.description %></p>
        </div>
      <% end %>
      <div class="grid md:grid-cols-2 gap-6">
        <div>
          <h3 class="text-sm font-semibold text-gray-700 mb-1">Status</h3>
          <p class="text-gray-600"><%= @subtask.status&.name || "-" %></p>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-gray-700 mb-1">Assignee</h3>
          <p class="text-gray-600"><%= @subtask.assignee&.email || "Unassigned" %></p>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-gray-700 mb-1">Story Points</h3>
          <p class="text-gray-600"><%= @subtask.story_point&.label || "-" %></p>
        </div>
<div>
  <h3 class="text-sm font-semibold text-gray-700 mb-1">Parent Task</h3>
  <%= link_to @task.title,
      task_path(@task),
      class: "text-blue-600 hover:text-blue-700 hover:underline" %>
</div>
        <div>
          <h3 class="text-sm font-semibold text-gray-700 mb-1">Start Date</h3>
          <p class="text-gray-600"><%= @subtask.start_date || "-" %></p>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-gray-700 mb-1">End Date</h3>
          <p class="text-gray-600"><%= @subtask.end_date || "-" %></p>
        </div>
      </div>
      <% if @subtask.attachments.attached? %>
        <div>
          <h3 class="text-sm font-semibold text-gray-700 mb-3">Attachments</h3>
          <div class="space-y-2">
            <% @subtask.attachments.each do |attachment| %>
              <div class="flex items-center justify-between rounded-lg border border-gray-200 p-3">
                <span class="text-sm text-gray-700">
                  <%= attachment.filename %>
                </span>
                <%= link_to "Download", rails_blob_path(attachment, disposition: "attachment"), class: "text-blue-600 hover:text-blue-700 text-sm font-medium" %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
      <div class="pt-4 border-t border-gray-200">
        <%= link_to "Back to Board", boards_path(project_id: @task.project_id), class: "text-sm font-medium text-blue-600 hover:text-blue-700" %>
      </div>
    </div>
  </div>
</div>
