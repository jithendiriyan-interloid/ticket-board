<turbo-frame id="modal">
  <div data-controller="modal" data-modal-target="container" data-action="click->modal#backdropClose" class="fixed inset-0 z-[100] overflow-y-auto bg-slate-900/50 px-4 py-8 sm:px-6">
    <div class="mx-auto mt-8 w-full max-w-3xl rounded-lg bg-slate-50 px-4 py-6 shadow-2xl sm:mt-12 sm:px-6">
      <div class="mb-6 flex items-start justify-between gap-4 border-b border-gray-200 pb-5">
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight text-gray-900">Edit Subtask</h1>
          <p class="mt-2 text-sm text-gray-500"><%= @task.title %></p>
        </div>
        <%= button_tag type: "button", data: { action: "click->modal#close" }, class: "rounded-lg p-2 text-slate-500 transition hover:bg-slate-200 hover:text-slate-900" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
          </svg>
        <% end %>
      </div>

      <% if @subtask.errors.any? %>
        <div class="mb-5 rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700">
          <%= @subtask.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <%= form_with model: [@task, @subtask], class: "space-y-5" do |f| %>
        <%= hidden_field_tag :return_to, params[:return_to] %>

        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
          <div class="grid gap-4 md:grid-cols-2">
            <div class="md:col-span-2">
              <%= f.label :title, "Subtask Title", class: "block text-sm font-medium mb-2" %>
              <%= f.text_field :title, class: "w-full h-[38px] px-2 rounded-lg border-gray-300 shadow-sm focus:outline-blue-600 text-sm" %>
            </div>
            <div class="md:col-span-2">
              <%= f.label :description, class: "block text-sm font-medium mb-2" %>
              <%= f.text_area :description, rows: 3, class: "h-[72px] px-2 w-full rounded-lg border-gray-300 shadow-sm focus:outline-blue-600 text-sm" %>
            </div>
            <div class="md:col-span-2">
              <%= f.label :attachments, "Attachments", class: "block text-sm font-medium mb-2" %>
              <%= f.file_field :attachments, multiple: true, class: "block text-sm" %>
            </div>
            <div>
              <%= f.label :status_id, "Status", class: "block text-sm font-medium mb-2" %>
              <%= f.collection_select :status_id, @available_statuses || [], :id, :name, {}, class: "w-full h-[38px] px-2 rounded-lg border-gray-300 shadow-sm focus:outline-blue-600 text-sm" %>
            </div>
            <div>
              <%= f.label :assignee_id, "Assignee", class: "block text-sm font-medium mb-2" %>
              <%= f.collection_select :assignee_id, @users || [], :id, :email, { prompt: "Unassigned" }, class: "w-full h-[38px] px-2 rounded-lg border-gray-300 shadow-sm focus:outline-blue-600 text-sm" %>
            </div>
            <div class="md:col-span-2">
              <%= f.label :story_point_id, "Story Points", class: "block text-sm font-medium mb-2" %>
              <div class="flex flex-wrap gap-2 mt-1">
                <% @story_points.each do |story_point| %>
                  <% c = story_point_pill_classes(story_point.label) %>
                  <label class="cursor-pointer inline-flex items-center">
                    <%= f.radio_button :story_point_id, story_point.id, class: "sr-only peer", id: "subtask_story_point_#{story_point.id}" %>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border transition-all select-none <%= c[:base] %> <%= c[:checked] %>">
                      <%= story_point.label %>
                    </span>
                  </label>
                <% end %>
              </div>
            </div>
            <div>
              <%= f.label :start_date, class: "block text-sm font-medium mb-2" %>
              <%= f.date_field :start_date, class: "w-full h-[38px] px-2 rounded-lg border-gray-300 shadow-sm focus:outline-blue-600 text-sm text-gray-600" %>
            </div>
            <div>
              <%= f.label :end_date, class: "block text-sm font-medium mb-2" %>
              <%= f.date_field :end_date, class: "w-full h-[38px] px-2 rounded-lg border-gray-300 shadow-sm focus:outline-blue-600 text-sm text-gray-600" %>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3">
          <%= button_tag "Cancel", type: "button", data: { action: "click->modal#close" }, class: "text-sm font-semibold hover:text-gray-900 px-4 py-2 rounded-lg hover:bg-gray-100 transition-colors" %>
          <%= f.submit "Update Subtask", class: "rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-medium text-white shadow-sm transition-all hover:bg-blue-700" %>
        </div>
      <% end %>
    </div>
  </div>
</turbo-frame>
