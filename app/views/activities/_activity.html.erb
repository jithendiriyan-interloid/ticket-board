<div id="<%= dom_id(activity) %>" class="flex gap-3 items-start">
  <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-400 to-purple-600 flex items-center justify-center text-xs font-bold text-white flex-shrink-0">
    <%= activity.user.email.first.upcase %>
  </div>
  <div class="flex-1">
    <p class="text-sm text-gray-600">
      <span class="font-medium text-gray-900"><%= activity.user.email %></span>
      <%= activity.action %>
    </p>
    <span class="text-xs text-gray-400"><%= time_ago_in_words(activity.created_at) %> ago</span>
  </div>
</div>