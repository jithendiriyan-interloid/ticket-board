<section class="bg-white rounded-sm shadow-md border border-gray-200 p-8 mb-8">
  <h3 class="text-3xl font-semibold text-gray-900 mb-6">Profile Picture</h3>
  <div class="flex items-center gap-6">
    <%= user_avatar(@user, "w-24 h-24 rounded-lg object-cover border-2 border-gray-300") %>
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-4" data-controller="avatar">
        <%= form_with model: @user, method: :patch do |f| %>
          <label class="cursor-pointer bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium shadow transition">
            <span>Upload New</span>
            <%= f.file_field :avatar, accept: ".jpg,.jpeg,.png,.gif,.webp", class: "hidden", data: {   avatar_target: "input", action: "change->avatar#validate" } %>
          </label>
        <% end %>
        <% if @user.avatar.attached? %>
          <%= form_with model: @user, method: :patch do |f| %>
            <%= hidden_field_tag :remove_avatar, "1" %>
            <%= f.submit "Remove", class: "cursor-pointer border border-gray-300 hover:bg-gray-100 text-gray-700 px-4 py-2 rounded-md text-sm font-medium transition" %>
          <% end %>
        <% end %>
      </div>
      <p class="text-sm text-gray-500">JPG, GIF, PNG or WEBP. Max size 800KB. </p>
    </div>
  </div>
</section>