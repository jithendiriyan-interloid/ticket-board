<main class="min-h-screen flex items-center justify-center bg-gray-50 py-8 px-4">
  <div class="w-full max-w-md">
    <!-- Edit Account Card -->
    <div class="bg-white border border-gray-200 rounded-xl p-8 shadow-sm">
      <h2 class="text-xl font-medium text-gray-900 mb-6">Change Password</h2>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, data: { controller: "form-validation", action: "submit->form-validation#validateForm" } }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <!-- Email -->
        <div class="mb-5">
          <%= f.label :email, class: "block text-sm font-medium text-gray-600 mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "you@example.com", class: "w-full h-[38px] px-3 text-sm rounded-lg border border-gray-300 bg-white text-gray-900 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors", data: { form_validation_target: "input", validation_type: "email", validation_required: "true", validation_label: "Email", validation_error_id: "email-error", action: "blur->form-validation#validateField input->form-validation#handleInput" } %>
          <span id="email-error" class="hidden text-red-500 text-xs mt-1 block"></span>
        </div>
        <!-- Current Password -->
        <div class="mb-6">
          <%= f.label :current_password, class: "block text-sm font-medium text-gray-600 mb-1.5" do %>
            Current password
            <span class="text-red-500">*</span>
          <% end %>
          <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "Required to save changes", class: "w-full h-[38px] px-3 text-sm rounded-lg border border-gray-300 bg-white text-gray-900 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors", data: { form_validation_target: "input", validation_type: "password", validation_required: "true", validation_label: "Current Password", validation_error_id: "current-password-error", action: "blur->form-validation#validateField input->form-validation#handleInput" } %>
          <span id="current-password-error" class="hidden text-red-500 text-xs mt-1 block"></span>
        </div>
        <!-- New Password -->
        <div class="mb-5">
          <%= f.label :password, class: "block text-sm font-medium text-gray-600 mb-1.5" do %>
            New password
          <% end %>
          <%= f.password_field :password, autocomplete: "new-password", placeholder: "New password", class: "w-full h-[38px] px-3 text-sm rounded-lg border border-gray-300 bg-white text-gray-900 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors", data: { form_validation_target: "input", validation_type: "password", validation_required: "false", validation_label: "Password", validation_error_id: "password-error", action: "blur->form-validation#validateField input->form-validation#handleInput" } %>
          <span id="password-error" class="hidden text-red-500 text-xs mt-1 block"></span>
        </div>
        <!-- Confirm New Password -->
        <div class="mb-5">
          <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-600 mb-1.5" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirm new password", class: "w-full h-[38px] px-3 text-sm rounded-lg border border-gray-300 bg-white text-gray-900 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors", data: { form_validation_target: "input", validation_type: "password", validation_required: "false", validation_label: "Password Confirmation", validation_error_id: "password-confirmation-error", action: "blur->form-validation#validateField input->form-validation#handleInput" } %>
          <span id="password-confirmation-error" class="hidden text-red-500 text-xs mt-1 block"></span>
        </div>
        <%= f.submit "Update account", class: "w-full h-[38px] px-4 text-sm font-medium rounded-lg text-white bg-blue-600 hover:bg-blue-700 border border-blue-600 cursor-pointer transition-colors tracking-wide" %>
      <% end %>
    </div>
    <!-- Back Link -->
    <div class="mt-4">
      <%= link_to :back, class: "inline-flex items-center gap-1.5 text-sm text-gray-400 hover:text-gray-700 transition-colors" do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
        Back
      <% end %>
    </div>
  </div>
</main>