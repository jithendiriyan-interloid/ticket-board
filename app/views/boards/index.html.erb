<div class="px-4 mt-16">
  <div class="w-[75%] mx-auto">
    <div class="px-4 py-6 bg-transparent rounded-md">
      <div class="mb-7 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-semibold">Hello, <%= @user.first_name %> </h2>
          <% if @project.present? %>
            <p class="mt-1 text-sm text-gray-500"><%= @project.name %> boards</p>
          <% end %>
        </div>
        <% unless @project.present? %>
          <%= link_to "New board", new_board_path, data: { turbo_frame: "modal" }, class: "text-sm px-3 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700" %>
        <% end %>
      </div>
      <% if @boards_by_project.empty? %>
        <div class="rounded-xl border border-dashed border-slate-200 py-12 text-center">
          <p class="text-sm font-medium text-slate-700">No boards found</p>
          <p class="mt-1 text-sm text-slate-400">Create a board inside an assigned project to get started.</p>
          <%= link_to "Create Board", new_board_path, data: { turbo_frame: "modal" }, class: "inline-flex mt-6 px-4 py-2 bg-gray-100 text-black rounded-lg text-sm hover:bg-gray-200" %>
        </div>
      <% end %>
      <% @boards_by_project.each do |project, boards| %>
        <section class="mb-6">
          <% boards.each do |board| %>
            <div class="flex items-center justify-between">
              <% if @project.blank? %>
                <%= link_to boards_path(project_id: project.id), class: "inline-flex items-center  px-4 py-2 text-sm font-medium text-gray-700 hover:text-blue-600 transition-colors" do %>
                  <%= board.name %>
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"></path>
                  </svg>
                <% end %>
              <% end %>
            </div>
            <% cards_by_status = board.cards.sort_by { |card| [card.status_id, card.position || 0, card.id] }.group_by(&:status_id) %>
            <div class="mb-8">
              <div class="flex gap-3 overflow-x-auto pb-4">
                <% @statuses.each do |status| %>
                  <% cards = cards_by_status[status.id] || [] %>
                  <% tasks = @tasks_by_project_status[[board.project_id, status.id]] || [] %>
                  <div class="bg-gray-50 rounded-xl border border-gray-200 w-72 flex-shrink-0 flex flex-col self-start">
                    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
                      <h3 class="text-sm font-medium text-gray-800 flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full inline-block" style="background-color: <%= status_colors[status.name] || '#888780' %>"></span>
                        <%= status.name %>
                      </h3>
                      <span class="text-xs font-mono text-black bg-white border border-gray-200 rounded-full px-2 py-0.5">
                        <%= cards.count + tasks.count %>
                      </span>
                    </div>
                    <div class="p-4 space-y-3">
                      <div class="space-y-3" data-controller="sortable-cards" data-sortable-cards-status-id-value="<%= status.id %>">
                        <% cards.each do |card| %>
                          <article class="cursor-grab rounded-lg border border-gray-100 bg-white p-3 shadow-sm active:cursor-grabbing" data-card-id="<%= card.id %>" data-board-id="<%= board.id %>">
                            <h4 class="text-sm font-semibold text-gray-900"><%= card.title %></h4>
                            <% if card.description.present? %>
                              <p class="mt-1 text-sm text-gray-600"><%= card.description %></p>
                            <% end %>
                          </article>
                        <% end %>
                        <% tasks.each do |task| %>
                          <article class="cursor-grab rounded-sm border border-gray-100 bg-white p-3 shadow-sm active:cursor-grabbing hover:shadow-md transition" data-task-id="<%= task.id %>">
                            <%= link_to task_path(task), data: { turbo_frame: "modal" },class: "block" do %>
                              <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                  <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Task</p>
                                  <h4 class="mt-1 text-sm font-semibold text-gray-900"><%= task.title %></h4>
                                </div>
                                <%= link_to  edit_task_path(task), data: { turbo_frame: "modal" }, class: "text-xs font-semibold text-blue-600 hover:underline" do %>
                                  <svg xmlns="http://www.w3.org/2000/svg" width="16px" height="16px" viewBox="0 0 16 16" fill="none">
                                    <g fill="#535353">
                                      <path fill-rule="evenodd" d="M11.436 1.005A1.75 1.75 0 0113.902.79l.702.589a1.75 1.75 0 01.216 2.465l-5.704 6.798a4.75 4.75 0 01-1.497 1.187l-2.572 1.299a.75.75 0 01-1.056-.886l.833-2.759a4.75 4.75 0 01.908-1.68l5.704-6.798zm1.502.934a.25.25 0 00-.353.03l-.53.633 1.082.914.534-.636a.25.25 0 00-.031-.352l-.703-.59zm-.765 2.726l-1.082-.914-4.21 5.016a3.25 3.25 0 00-.621 1.15L5.933 11l1.01-.51a3.249 3.249 0 001.024-.812l4.206-5.013z" clip-rule="evenodd"/>
                                      <path d="M3.25 3.5a.75.75 0 00-.75.75v9.5c0 .414.336.75.75.75h9.5a.75.75 0 00.75-.75V9A.75.75 0 0115 9v4.75A2.25 2.25 0 0112.75 16h-9.5A2.25 2.25 0 011 13.75v-9.5A2.25 2.25 0 013.25 2H6a.75.75 0 010 1.5H3.25z"/>
                                    </g>
                                  </svg>
                                <% end %>
                              </div>
                              <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                                <% if task.task_type.present? %>
                                  <span class="rounded-full bg-slate-100 px-2 py-0.5"><%= task.task_type.name %></span>
                                <% end %>
                                <% if task.label.present? %>
                                  <span class="rounded-full bg-slate-100 px-2 py-0.5"><%= task.label.name %></span>
                                <% end %>
                                <div class="flex">
                                  <% if task.assignee.present? %>
                                    <% assignee_initials = "#{task.assignee.first_name&.first}#{task.assignee.last_name&.first}".presence || task.assignee.email.first %>
                                    <% assignee_name = [task.assignee.first_name, task.assignee.last_name].compact_blank.join(" ").presence || task.assignee.email %>
                                    <div class="relative inline-block" data-controller="hover-popup" data-action="mouseenter->hover-popup#show mouseleave->hover-popup#hide">
                                      <span class="truncate rounded-full bg-slate-100 px-2 py-0.5 cursor-pointer select-none text-xs font-medium text-slate-600">
                                        <%= assignee_initials.upcase %>
                                      </span>
                                      <div data-hover-popup-target="popup" class="absolute bottom-full left-1/2 -translate-x-1/2  z-50 hidden w-70 rounded-xl border border-slate-100 bg-white shadow-lg shadow-slate-200/60">
                                        <div class="px-4 py-3 border-b border-slate-100">
                                          <div class="flex items-center gap-2.5">
                                            <div class="w-7 h-7 rounded-full bg-slate-100 flex items-center justify-center text-xs font-semibold text-slate-500 shrink-0">
                                              <%= assignee_initials.upcase %>
                                            </div>
                                            <div class="min-w-0">
                                              <p class="text-sm font-medium text-slate-800 truncate leading-none mb-0.5"> <%= assignee_name %> </p>
                                              <p class="text-xs text-slate-400 truncate leading-none"><%= task.assignee.email %></p>
                                            </div>
                                          </div>
                                        </div>
                                        <div class="p-1.5">
                                          <%= link_to user_path(task.assignee), class: "flex items-center gap-2 w-full px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors group" do %>
                                            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
                                            </svg>
                                            View profile
                                          <% end %>
                                          <%= link_to edit_user_path(task.assignee), class: "flex items-center gap-2 w-full px-3 py-2 rounded-lg text-sm text-slate-600 hover:bg-slate-100 hover:text-slate-900 transition-colors group" do %>
                                            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-slate-600 transition-colors" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                            Edit profile
                                          <% end %>
                                        </div>
                                      </div>
                                    </div>
                                  <% else %>
                                    <span class="truncate rounded-full bg-slate-100 px-2 py-0.5 text-xs font-medium text-slate-500"> Unassigned </span>
                                  <% end %>
                                  <% if task.start_date.present? && task.end_date.present? %>
                                    <% overdue = task.end_date < Date.today && task.status&.name != "Done" %>
                                    <span class="truncate px-2 py-0.5 text-xs <%= overdue ? 'text-red-500' : 'text-slate-500' %>">
                                      <%= task.start_date.strftime("%b %d") %> - <%= task.end_date.strftime("%b %d, %Y") %>
                                    </span>
                                  <% end %>
                                </div>
                                <div class="ml-8">
                                  <% if task.subtasks.exists? %>
                                      <%= link_to task_subtask_path(task, task.subtasks.first), class: "text-gray-500 hover:text-blue-500",  data: { turbo_frame: "modal" } do %>
                                        <div class="flex flex-row ">
                                          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                                            <path d="M20,15c-1.9,0-3.4,1.3-3.9,3H7c-2.8,0-5-2.2-5-5v-3h14.1c0.4,1.7,2,3,3.9,3c2.2,0,4-1.8,4-4s-1.8-4-4-4c-1.9,0-3.4,1.3-3.9,3H2V3c0-0.6-0.4-1-1-1S0,2.4,0,3v10c0,3.9,3.1,7,7,7h9.1c0.4,1.7,2,3,3.9,3c2.2,0,4-1.8,4-4S22.2,15,20,15z"></path>
                                          </svg>
                                          <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path d="M9.707 2.793A.998.998 0 0 0 8 3.5v17a1 1 0 0 0 1.707.707l8.5-8.5a.999.999 0 0 0 0-1.414l-8.5-8.5Z"></path></svg>
                                        </div>
                                    <% end %>
                                  <% end %>
                                </div>
                              </div>
                            <% end %>
                          </article>
                        <% end %>
                      </div>
                      <div class="border-t border-gray-200 pt-3" data-turbo-permanent id="new_card_<%= board.id %>_<%= status.id %>">
                        <%= render "tasks/form", board: board, status: status %>
                      </div>
                    </div>
                  </div>
                <% end %>
                <%= link_to new_status_path, class: "inline-flex h-fit items-center gap-1.5 px-3.5 py-1.5 bg-gray-100 hover:bg-gray-200 border border-gray-200 rounded-md text-sm font-medium text-gray-700 transition-colors" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                  Add status
                <% end %>
              </div>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>
  </div>
</div>
