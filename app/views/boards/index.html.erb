<div class="px-4 mt-16">
  <div class="w-[75%] mx-auto">
    <div class="px-4 py-6 bg-transparent rounded-md">
      <div class="mb-7 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-semibold">Hello, <%= @user.first_name %> </h2>
          <% if @project.present? %>
            <p class="mt-1 text-sm text-gray-500"><%= @project.name %> boards</p>
          <% end %>
        </div>
        <% if @project.present? %>
          <%= link_to "New board", new_board_path(project_id: @project.id), data: { turbo_frame: "modal" }, class: "text-sm px-3 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700" %>
        <% end %>
      </div>
      <% if @boards_by_project.empty? %>
        <div class="rounded-xl border border-dashed border-slate-200 py-12 text-center">
          <p class="text-sm font-medium text-slate-700">No boards found</p>
          <p class="mt-1 text-sm text-slate-400">Create a board inside an assigned project to get started.</p>
        </div>
      <% end %>
      <% @boards_by_project.each do |project, boards| %>
        <section class="mb-10">
          <div class="mb-5 flex items-center justify-between">
            <div>
              <h3 class="text-lg font-semibold text-gray-900"><%= project.name %></h3>
              <p class="text-sm text-gray-500"><%= project.workspace.name %></p>
            </div>
            <% if @project.blank? %>
              <%= link_to "View project boards", boards_path(project_id: project.id), class: "text-sm text-blue-600 hover:underline" %>
            <% end %>
          </div>
          <% project_tasks = project.tasks.to_a %>
          <% boards.each do |board| %>
            <div class="mb-8">
              <div class="mb-4 flex items-center justify-between">
                <div>
                  <h4 class="text-base font-semibold text-gray-900"><%= board.name %></h4>
                  <p class="text-sm text-gray-500">Board</p>
                </div>
                <% if policy(board).edit? %>
                  <%= link_to "Edit", edit_board_path(board), data: { turbo_frame: "modal" }, class: "text-sm text-blue-600 hover:underline" %>
                <% end %>
              </div>
              <div class="flex gap-3 overflow-x-auto pb-4">
                <% @statuses.each do |status| %>
                  <% tasks = project_tasks.select { |task| task.status_id == status.id } %>
                  <div class="bg-gray-50 rounded-xl border border-gray-200 w-72 flex-shrink-0 flex flex-col">
                    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
                      <h3 class="text-sm font-medium text-gray-800 flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full inline-block" style="background-color: <%= status_colors[status.name] || '#888780' %>"></span>
                        <%= status.name %>
                      </h3>
                      <span class="text-xs font-mono text-gray-400 bg-white border border-gray-200 rounded-full px-2 py-0.5">
                        <%= tasks.count %>
                      </span>
                    </div>
                    <div class="p-4 space-y-3 min-h-24">
                      <% tasks.each do |task| %>
                        <article class="rounded-lg border border-gray-200 bg-white p-3 shadow-sm">
                          <h4 class="text-sm font-semibold text-gray-900"><%= task.title %></h4>
                          <div class="flex flex-row gap-2">
                            <% if task.label.present? %>
                              <p class="mt-1 text-sm text-gray-600"><%= task.label.name %></p>
                            <% end %>
                            <% if task.task_type.present? %>
                              <p class="mt-1 text-sm text-gray-600"><%= task.task_type.name %></p>
                            <% end %>
                          </div>
                          <%= link_to "Edit", edit_task_path(task), data: { turbo_frame: "modal" }, class: "text-blue-600 hover:underline" %>
                        </article>
                      <% end %>
                    </div>
                  </div>
                <% end %>
                <%= link_to new_status_path, class: "inline-flex h-fit items-center gap-1.5 px-3.5 py-1.5 bg-gray-100 hover:bg-gray-200 border border-gray-200 rounded-md text-sm font-medium text-gray-700 transition-colors" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                  Add status
                <% end %>
              </div>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>
  </div>
</div>
