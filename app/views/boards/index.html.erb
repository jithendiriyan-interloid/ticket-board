<div class="px-4 mt-16">
  <div class="w-[75%] mx-auto">
    <div class="px-4 py-6 bg-transparent rounded-md">
      <div class="mb-7 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-semibold">Hello, <%= @user.first_name %> </h2>
          <% if @project.present? %>
            <p class="mt-1 text-sm text-gray-500"><%= @project.name %> boards</p>
          <% end %>
        </div>
        <% unless @project.present? %>
          <%= link_to "New board", new_board_path, data: { turbo_frame: "modal" }, class: "text-sm px-3 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700" %>
        <% end %>
      </div>
      <% if @boards_by_project.empty? %>
        <div class="rounded-xl border border-dashed border-slate-200 py-12 text-center">
          <p class="text-sm font-medium text-slate-700">No boards found</p>
          <p class="mt-1 text-sm text-slate-400">Create a board inside an assigned project to get started.</p>
        </div>
      <% end %>
      <% @boards_by_project.each do |project, boards| %>
        <section class="mb-6">
          <div class="flex items-center justify-between">
            <% if @project.blank? %>
              <%= link_to "View project boards", boards_path(project_id: project.id), class: "text-sm text-blue-600 hover:underline" %>
            <% end %>
          </div>
          <% boards.each do |board| %>
            <% cards_by_status = board.cards.sort_by { |card| [card.status_id, card.position || 0, card.id] }.group_by(&:status_id) %>
            <div class="mb-8">
              <div class="mb-4 flex items-center justify-between">
                <div>
                  <p class="text-base font-semibold text-gray-900">Board</p>
                  <h4 class="text-sm text-gray-500"><%= board.name %></h4>
                </div>
                <% if policy(board).edit? %>
                  <%= link_to edit_board_path(board), data: { turbo_frame: "modal" }, class: "text-gray-400 hover:text-blue-600 transition-colors" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="black" class="h-5 w-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.862 4.487Z" />
                    </svg>
                  <% end %>
                <% end %>
              </div>
              <div class="flex gap-3 overflow-x-auto pb-4">
                <% @statuses.each do |status| %>
                  <% cards = cards_by_status[status.id] || [] %>
                  <% tasks = @tasks_by_project_status[[board.project_id, status.id]] || [] %>
                  <div class="bg-gray-50 rounded-xl border border-gray-200 w-72 flex-shrink-0 flex flex-col self-start">
                    <div class="px-4 py-3 border-b border-gray-200 flex items-center justify-between">
                      <h3 class="text-sm font-medium text-gray-800 flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full inline-block" style="background-color: <%= status_colors[status.name] || '#888780' %>"></span>
                        <%= status.name %>
                      </h3>
                      <span class="text-xs font-mono text-black bg-white border border-gray-200 rounded-full px-2 py-0.5">
                        <%= cards.count + tasks.count %>
                      </span>
                    </div>
                    <div class="p-4 space-y-3">
                      <div class="space-y-3" data-controller="sortable-cards" data-sortable-cards-status-id-value="<%= status.id %>">
                        <% cards.each do |card| %>
                          <article class="cursor-grab rounded-lg border border-gray-200 bg-white p-3 shadow-sm active:cursor-grabbing" data-card-id="<%= card.id %>" data-board-id="<%= board.id %>">
                            <h4 class="text-sm font-semibold text-gray-900"><%= card.title %></h4>
                            <% if card.description.present? %>
                              <p class="mt-1 text-sm text-gray-600"><%= card.description %></p>
                            <% end %>
                          </article>
                        <% end %>
                        <% tasks.each do |task| %>
                          <article class="cursor-grab rounded-lg border border-indigo-200 bg-white p-3 shadow-sm active:cursor-grabbing hover:shadow-md transition" data-task-id="<%= task.id %>">
                            <%= link_to task_path(task), data: { turbo_frame: "modal" },class: "block" do %>
                              <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                  <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">Task</p>
                                  <h4 class="mt-1 text-sm font-semibold text-gray-900"><%= task.title %></h4>
                                </div>
                                <%= link_to  edit_task_path(task), data: { turbo_frame: "modal" }, class: "text-xs font-semibold text-blue-600 hover:underline" do %>
                                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="black" class="h-5 w-5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.862 4.487Z" />
                                    </svg>
                                <% end %>
                              </div>
                              <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-slate-500">
                                <% if task.task_type.present? %>
                                  <span class="rounded-full bg-slate-100 px-2 py-0.5"><%= task.task_type.name %></span>
                                <% end %>
                                <% if task.label.present? %>
                                  <span class="rounded-full bg-slate-100 px-2 py-0.5"><%= task.label.name %></span>
                                <% end %>
                                <% if task.assignee.present? %>
                                  <span class="truncate"><%= task.assignee.email %></span>
                                <% end %>
                              </div>
                            <% end %>
                          </article>
                        <% end %>
                      </div>
                      <div class="border-t border-gray-200 pt-3" data-turbo-permanent id="new_card_<%= board.id %>_<%= status.id %>">
                        <%= render "tasks/form", board: board, status: status %>
                      </div>
                    </div>
                  </div>
                <% end %>
                <%= link_to new_status_path, class: "inline-flex h-fit items-center gap-1.5 px-3.5 py-1.5 bg-gray-100 hover:bg-gray-200 border border-gray-200 rounded-md text-sm font-medium text-gray-700 transition-colors" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
                  Add status
                <% end %>
              </div>
            </div>
          <% end %>
        </section>
      <% end %>
    </div>
  </div>
</div>
