<% if @workspaces.present? %>
  <div class="w-[50%] mx-auto mt-20">
    <div class="mb-4 flex items-center justify-between">
      <div>
        <h2 class="text-xl font-semibold">Workspace List</h2>
        <p class="text-sm mt-1 text-slate-500">
          <%= @workspaces.count %> total workspaces </p>
      </div>
      <% if policy(Workspace).create? %>
        <%= link_to "Create Workspace", new_workspace_path, data: { turbo_frame: "modal" }, class: "px-4 py-2 bg-blue-600 text-white rounded-lg text-sm" %>
      <% end %>
    </div>
    <div class="overflow-x-auto bg-white border border-slate-200 rounded-lg shadow-sm">
      <table class="min-w-full">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-6 py-4 text-left text-sm font-semibold"> Name </th>
            <th class="px-6 py-4 text-left text-sm font-semibold"> Description </th>
            <th class="px-6 py-4 text-center text-sm font-semibold"> Owner </th>
            <th class="px-6 py-4 text-center text-sm font-semibold"> Actions </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @workspaces.each do |workspace| %>
            <tr class="hover:bg-slate-50 transition">
              <td class="px-6 py-4 text-sm font-medium">
                <%= workspace.name %>
              </td>
              <td class="px-6 py-4 text-sm text-slate-600">
                <%= workspace.description.presence || "No description" %>
              </td>
              <td class="px-6 py-4 text-center text-sm">
                <%= workspace.owner&.first_name || "Unknown" %>
              </td>
              <td class="px-6 py-4">
                <div class="flex justify-center gap-2">
                  <%= link_to "View", workspace_path(workspace), class: "px-3 py-2 text-sm bg-slate-200 rounded-lg" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="max-w-md mx-auto mt-32 text-center">
      <div class="bg-white border border-slate-200 rounded-lg p-8 shadow-sm">
        <h2 class="text-xl font-semibold text-slate-900">
          No Workspaces Found
        </h2>
        <p class="mt-2 text-sm text-slate-500">
          Create your workspace to get started. </p>
        <% if policy(Workspace).create? %>
          <%= link_to "Create Workspace", new_workspace_path, data: { turbo_frame: "modal" }, class: "inline-flex mt-6 px-4 py-2 bg-gray-100 text-black rounded-lg text-sm hover:bg-gray-200" %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>