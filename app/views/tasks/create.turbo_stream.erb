<%= turbo_stream.append "comments_list", partial: "tasks/comment", locals: { comment: @comment } %>
<%= turbo_stream.replace "comment_form" do %>
  <%= form_with model: [@task, Comment.new] do |f| %>
    <div class="flex-1">
      <%= f.text_area :description, rows: 2, placeholder: "Add a comment…", class: "w-full text-sm px-3 py-2 border border-gray-200 rounded-lg resize-none focus:outline-none focus:ring-1 focus:ring-blue-300" %>
      <div class="flex justify-end mt-2">
        <%= f.submit "Comment", class: "text-sm px-4 py-1.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 cursor-pointer font-medium transition-colors" %>
      </div>
    </div>
  <% end %>
<% end %>
<%= turbo_stream.remove "no_comments" %>