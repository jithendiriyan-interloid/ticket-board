<turbo-frame id="modal">
  <div data-controller="drawer" data-action="click->drawer#backdropClose" class="fixed inset-0 z-[100] bg-black/40"> 
    <div data-drawer-target="panel" class="absolute right-0 top-0 h-full w-[35%] overflow-y-auto bg-gradient-to-b from-white to-gray-50 shadow-2xl transform transition-transform duration-300 ease-out">
      <!-- Close Button -->
      <button onclick="document.querySelector('[data-drawer-target=panel]').parentElement.click()" class="absolute top-6 right-6 text-gray-400 hover:text-gray-600 z-10">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <div class="py-8">
        <div class="mx-auto sm:px-6 lg:px-8">
          <!-- Header -->
          <div class="flex flex-row justify-between">
            <div class="mb-8 pr-12">
              <div class="mb-4">
                <h1 class="text-3xl font-bold text-gray-900 tracking-tight">
                  Task Details
                </h1>
                <p class="mt-2 text-sm font-medium text-gray-500"><%= @task.title %></p>
              </div>
            </div>
            <div class="mt-6">
              <%= link_to  edit_task_path(@task), class: "text-xs font-semibold hover:text-blue-500" do %>
                <svg xmlns="http://www.w3.org/2000/svg" width="16px" height="16px" viewBox="0 0 16 16" fill="none">
                  <g fill="#535353">
                    <path fill-rule="evenodd" d="M11.436 1.005A1.75 1.75 0 0113.902.79l.702.589a1.75 1.75 0 01.216 2.465l-5.704 6.798a4.75 4.75 0 01-1.497 1.187l-2.572 1.299a.75.75 0 01-1.056-.886l.833-2.759a4.75 4.75 0 01.908-1.68l5.704-6.798zm1.502.934a.25.25 0 00-.353.03l-.53.633 1.082.914.534-.636a.25.25 0 00-.031-.352l-.703-.59zm-.765 2.726l-1.082-.914-4.21 5.016a3.25 3.25 0 00-.621 1.15L5.933 11l1.01-.51a3.249 3.249 0 001.024-.812l4.206-5.013z" clip-rule="evenodd"/>
                    <path d="M3.25 3.5a.75.75 0 00-.75.75v9.5c0 .414.336.75.75.75h9.5a.75.75 0 00.75-.75V9A.75.75 0 0115 9v4.75A2.25 2.25 0 0112.75 16h-9.5A2.25 2.25 0 011 13.75v-9.5A2.25 2.25 0 013.25 2H6a.75.75 0 010 1.5H3.25z"/>
                  </g>
                </svg>
              <% end %>
            </div>
          </div>
          <div class="border-t border-gray-200 mb-8"></div>
          <!-- Overview -->
          <div class="mb-8">
            <h2 class="mb-5 text-lg font-bold text-gray-900">Overview</h2>
            <div class="grid gap-5 md:grid-cols-2">
              <div class="bg-white rounded-lg border border-gray-200 px-4 py-2 hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Status</p>
                <p class="mt-2 text-sm font-medium text-gray-900"><%= @task.status&.name || "No Status" %></p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 px-4 py-2  hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Board</p>
                <p class="mt-2 text-sm font-medium text-gray-900"><%= @task.project&.name || "—" %></p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 px-4 py-2  hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Type</p>
                <p class="mt-2 text-sm font-medium text-gray-900"><%= @task.task_type&.name || "—" %></p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 px-4 py-2  hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Story Points</p>
                <p class="mt-2 text-sm font-medium text-gray-900"><%= @task.story_point&.label || "—" %></p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 px-4 py-2  hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Label</p>
                <p class="mt-2 text-sm font-medium text-gray-900"><%= @task.label&.name || "—" %></p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 px-4 py-2  hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Assigned To</p>
                <div class="mt-2 flex items-center gap-2">
                  <div class="h-7 w-7 flex-shrink-0 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-xs font-bold text-white">
                    <%= @task.assignee&.email&.first&.upcase || "U" %>
                  </div>
                  <p class="text-sm font-medium text-gray-900 truncate"><%= @task.assignee&.email || "U" %></p>
                </div>
              </div>
            </div>
          </div>
          <!-- Description -->
          <div class="mb-8">
            <h2 class="mb-5 text-lg font-bold text-gray-900">Description</h2>
            <div class="bg-white rounded-lg border border-gray-200 px-4 py-2">
              <p class="text-sm text-gray-700 leading-relaxed">
                <%= @task.description.present? ? @task.description : '<span class="text-gray-400 italic">No description provided</span>'.html_safe %>
              </p>
            </div>
          </div>
          <!-- Attachements -->
          <div class="mb-8">
            <h2 class="mb-5 text-lg font-bold text-gray-900">Attachments</h2>
            <div class="bg-white rounded-lg border border-gray-200 p-2">
              <% if @task.attachments.attached? %>
                <ul class="grid grid-cols-4 gap-2">
                  <% @task.attachments.each do |attachment| %>
                    <li class="flex items-center text-sm text-gray-500">
                      <%= link_to attachment.filename, rails_blob_path(attachment, disposition: "attachment"), class: "hover:text-blue-600 hover:underline truncate", target: "_blank" %>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-sm text-gray-400">No attachments.</p>
              <% end %>
            </div>
          </div>
          <!-- Timeline -->
          <div class="mb-8">
            <h2 class="mb-5 text-lg font-bold text-gray-900">Timeline</h2>
            <div class="grid gap-5 md:grid-cols-2">
              <div class="bg-white rounded-lg border border-gray-200 px-4 py-2 hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">Start Date</p>
                <p class="mt-2 text-sm font-medium text-gray-900"><%= @task.start_date&.strftime("%d %b %Y") || "—" %></p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 px-4 py-2 hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">End Date</p>
                <p class="mt-2 text-sm font-medium text-gray-900">
                  <% if @task.end_date %>
                    <% overdue = @task.end_date < Date.today && @task.status&.name != "Done" %>
                    <span class="<%= overdue ? 'text-red-600 font-semibold' : '' %>"><%= @task.end_date.strftime("%d %b %Y") %></span>
                    <% if overdue %><span class="ml-1 text-xs text-red-500">(overdue)</span><% end %>
                  <% else %>—<% end %>
                </p>
              </div>
            </div>
          </div>
          <!-- Subtasks -->
          <div class="pt-6 border-t border-gray-200 mb-8">
            <div class="flex items-center justify-between mb-5">
              <div class="flex items-center gap-2">
                <h2 class="text-lg font-bold text-gray-900">Subtasks</h2>
                <% if @task.subtasks.any? %>
                  <span class="inline-flex items-center justify-center h-5 min-w-[1.25rem] px-1.5 rounded-full bg-blue-100 text-blue-700 text-xs font-bold">
                    <%= @task.subtasks.count %>
                  </span>
                <% end %>
              </div>
              <%= link_to new_task_subtask_path(@task),
                  class: "inline-flex items-center gap-1 rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-xs font-semibold text-gray-600 hover:border-blue-300 hover:text-blue-600 transition-colors shadow-sm",
                  data: { turbo_frame: "modal" } do %>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add Subtask
              <% end %>
            </div>
            <% if @task.subtasks.any? %>
              <div class="space-y-3">
                <% @task.subtasks.each do |subtask| %>
                  <div class="group relative bg-white rounded-xl border border-gray-200 p-4 hover:border-gray-300 hover:shadow-sm transition-all">
                    <div class="flex items-start justify-between gap-3">
                      <div class="min-w-0 flex-1">
                        <!-- Title + status -->
                        <div class="flex items-center gap-2 flex-wrap">
                          <p class="text-sm font-semibold text-gray-900 truncate"><%= subtask.title %></p>
                          <% if subtask.status.present? %>
                            <span class="inline-flex items-center gap-1 rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">
                              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                              <%= subtask.status.name %>
                            </span>
                          <% end %>
                        </div>
                        <!-- Description -->
                        <% if subtask.description.present? %>
                          <p class="mt-1 text-xs text-gray-500 line-clamp-2"><%= subtask.description %></p>
                        <% end %>
                        <!-- Meta row -->
                        <div class="mt-3 flex items-center gap-3 flex-wrap">
                          <% if subtask.assignee.present? %>
                            <div class="flex items-center gap-1.5">
                              <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-gradient-to-br from-blue-400 to-blue-600 text-[10px] font-bold text-white">
                                <%= subtask.assignee.email.first.upcase %>
                              </span>
                            </div>
                          <% else %>
                            <span class="text-xs text-gray-400 italic">Unassigned</span>
                          <% end %>
                          <% if subtask.story_point.present? %>
                            <span class="inline-flex items-center rounded-full bg-indigo-50 px-2 py-0.5 text-xs font-semibold text-indigo-600 ring-1 ring-indigo-100">
                              <%= subtask.story_point.label %>
                            </span>
                          <% end %>
                          <% if subtask.end_date.present? %>
                            <% sub_overdue = subtask.end_date < Date.today && subtask.status&.name != "Done" %>
                            <span class="flex items-center gap-1 text-xs <%= sub_overdue ? 'text-red-500 font-medium' : 'text-gray-400' %>">
                              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                              </svg>
                              <%= subtask.end_date.strftime("%d %b") %>
                              <%= " · overdue" if sub_overdue %>
                            </span>
                          <% end %>
                        </div>
                      </div>
                      <!-- Edit Button -->
                      <% if subtask.id.present? %>
                        <%= link_to edit_task_subtask_path(@task, subtask), class: "opacity-0 group-hover:opacity-100 flex-shrink-0 inline-flex items-center gap-1 rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-500 hover:border-blue-300 hover:text-blue-600 transition-all shadow-sm", data: { turbo_frame: "modal" } do %>
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Z" />
                          </svg>
                          Edit
                        <% end %>
                        <%= link_to task_subtask_path(@task, subtask), class: "opacity-0 group-hover:opacity-100 flex-shrink-0 inline-flex items-center gap-1 rounded-lg border border-gray-200 bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-500 hover:border-green-300 hover:text-green-600 transition-all shadow-sm", data: { turbo_frame: "modal" } do  %>
                          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178Z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
                          </svg>
                          Show
                        <% end %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-gray-200 bg-white py-8 text-center">
                <svg class="mb-2 h-8 w-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <p class="text-sm text-gray-400">No subtasks yet</p>
                <%= link_to "Add the first one", new_task_subtask_path(@task), class: "mt-1 text-xs font-medium text-blue-500 hover:text-blue-700", data: { turbo_frame: "modal" } %>
              </div>
            <% end %>
          </div>
          <!-- Activity & Comments -->
          <div class="pt-6 border-t border-gray-200 mb-8" data-controller="tabs" data-tabs-active-value="activity">
            <div class="border-b border-gray-200 flex gap-6 mb-6">
              <button data-tabs-target="tab" data-action="click->tabs#switch" data-tabs-tab-param="activity" class="pb-3 text-sm font-medium border-b-2 border-gray-900 text-gray-900"> Activity </button>
              <button data-tabs-target="tab" data-action="click->tabs#switch" data-tabs-tab-param="comments" class="pb-3 text-sm font-medium border-b-2 border-transparent text-gray-400 flex items-center gap-1.5"> Comments </button>
            </div>
            <div data-tabs-target="panel" data-tabs-panel="activity"> <%= render "activities/activity_feed", activities: @activities %> </div>
            <div data-tabs-target="panel" data-tabs-panel="comments"> <%= render "comments/comment_feed", task: @task %> </div>
          </div>
          <!--  -->
          <div class="pt-4 border-t border-gray-200">
          </div>
        </div>
      </div>
    </div>
  </div>
</turbo-frame>  