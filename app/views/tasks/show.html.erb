<turbo-frame id="modal">
  <div data-controller="drawer" data-action="click->drawer#backdropClose" class="fixed inset-0 z-[100] bg-black/40"> 
    <div data-drawer-target="panel" class="absolute right-0 top-0 h-full w-[40%] overflow-y-auto bg-gradient-to-b from-white to-gray-50 shadow-2xl transform transition-transform duration-300 ease-out">
      <!-- Close Button -->
      <button onclick="document.querySelector('[data-drawer-target=panel]').parentElement.click()" class="absolute top-6 right-6 text-gray-400 hover:text-gray-600 z-10">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
      <div class="py-8">
        <div class="mx-auto sm:px-6 lg:px-8">
          <!-- Header -->
          <div class="flex flex-row justify-between">
            <div class="mb-8 pr-12">
              <div class="mb-4">
                <h1 class="text-4xl font-bold text-gray-900 tracking-tight">
                  <%= @task.title %>
                </h1>
                <p class="mt-2 text-sm font-medium text-gray-500">
                  Task Details
                </p>
              </div>
            </div>
            <!-- Edit Button -->
            <div class="mt-6">
              <%= link_to "Edit Task", edit_task_path(@task), class: "inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2 text-sm font-semibold text-white hover:bg-blue-700 shadow-sm hover:shadow-md transition-all" %>
            </div>
          </div>
          <!-- Divider -->
          <div class="border-t border-gray-200 mb-8"></div>
          <!-- Task Information Card -->
          <div class="mb-8">
            <h2 class="mb-5 text-lg font-bold text-gray-900">
              Overview
            </h2>
            <div class="grid gap-5 md:grid-cols-2">
              <!-- Status Card (Full Width) -->
              <div class="bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">
                  Status
                </p>
                <p class="mt-2 text-sm font-medium text-gray-900">
                  <%= @task.status&.name || "No Status" %>
                </p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">
                  Board
                </p>
                <p class="mt-2 text-sm font-medium text-gray-900">
                  <%= @task.project&.name || "—" %>
                </p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">
                  Type
                </p>
                <p class="mt-2 text-sm font-medium text-gray-900">
                  <%= @task.task_type&.name || "—" %>
                </p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">
                  Story Points
                </p>
                <p class="mt-2 text-sm font-medium text-gray-900">
                  <%= @task.story_point&.label || "—" %>
                </p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">
                  Label
                </p>
                <p class="mt-2 text-sm font-medium text-gray-900">
                  <%= @task.label&.name || "—" %>
                </p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500"> Assigned To </p>
                <div class="flex items-center gap-2">
                <div class="h-8 w-8 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-xs font-bold text-white">
                  <%= @task.assignee&.email&.first&.upcase || "U" %>
                </div>
                <p class="mt-2 text-sm font-medium text-gray-900">
                  <%= @task.assignee&.email || "Unassigned" %>
                </p>
                </div>
              </div>
            </div>
          </div>
          <!-- Description Card -->
          <div class="mb-8">
            <h2 class="mb-5 text-lg font-bold text-gray-900">
              Description
            </h2>
            <div class="bg-white rounded-lg border border-gray-200 p-5">
              <p class="text-sm text-gray-700 leading-relaxed">
                <%= @task.description.present? ? @task.description : '<span class="text-gray-400 italic">No description provided</span>'.html_safe %>
              </p>
            </div>
          </div>
          <!-- Dates -->
          <div class="mb-8">
            <h2 class="mb-5 text-lg font-bold text-gray-900">
              Timeline 
            </h2>
            <div class="grid gap-5 md:grid-cols-2">
              <div class="bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">
                  Start Date
                </p>
                <p class="mt-2 text-sm font-medium text-gray-900">
                  <%= @task.start_date&.strftime("%d %b %Y") || "—" %>
                </p>
              </div>
              <div class="bg-white rounded-lg border border-gray-200 p-4 hover:border-gray-300 transition-colors">
                <p class="text-xs font-semibold uppercase tracking-widest text-gray-500">
                  End Date
                </p>
                <p class="mt-2 text-sm font-medium text-gray-900">
                  <%= @task.end_date&.strftime("%d %b %Y") || "—" %>
                </p>
              </div>
            </div>
          </div>
          <!-- Comments and Activity -->
          <div class="pt-6 border-t border-gray-200">
            <div>
              <h2 class="mb-5 text-lg font-bold text-gray-900">
                Activity & Comments
              </h2>
            </div>
          </div>
          <!-- Metadata -->
          <div class="pt-6 border-t border-gray-200">
            <p class="text-xs text-gray-400">
              Created on <%= @task.created_at.strftime("%d %B %Y at %I:%M %p") %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</turbo-frame>