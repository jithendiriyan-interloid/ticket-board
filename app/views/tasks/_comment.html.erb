<div id="<%= dom_id(comment) %>" class="flex gap-3">
  <div class="w-8 h-8 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center text-xs font-bold text-white flex-shrink-0">
    <%= comment.user.email.first.upcase %>
  </div>
  <div class="flex-1 bg-gray-50 rounded-lg px-3.5 py-2.5 border border-gray-100">
    <div class="flex justify-between mb-1">
      <span class="text-sm font-medium text-gray-900"><%= comment.user.email %></span>
      <span class="text-xs text-gray-400"><%= time_ago_in_words(comment.created_at) %> ago</span>
    </div>
    <p class="text-sm text-gray-600 leading-relaxed"><%= comment.description %></p>
  </div>
</div>