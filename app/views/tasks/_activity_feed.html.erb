<% if activities&.any? %>
  <div class="flex flex-col">
    <% activities.each_with_index do |activity, i| %>
      <div class="flex gap-3">
        <div class="flex flex-col items-center">
          <div class="w-2 h-2 rounded-full mt-1.5 <%= activity.key.include?('status') ? 'bg-green-500' : 'bg-gray-300' %>"></div>
          <% unless i == activities.size - 1 %>
            <div class="w-px bg-gray-200 flex-1 mt-1"></div>
          <% end %>
        </div>
        <div class="pb-5">
          <div class="flex items-center gap-2 mb-0.5 flex-wrap">
            <% if activity.key.include?('create') %>
              <span class="text-sm font-medium text-gray-900">Created</span>
            <% elsif activity.key.include?('status') %>
              <span class="text-sm font-medium text-gray-900">Status changed</span>
              <span class="text-xs bg-blue-50 text-blue-700 px-2 py-0.5 rounded font-medium">
                <%= activity.parameters[:status] %>
              </span>
            <% else %>
              <span class="text-sm font-medium text-gray-900">Updated</span>
              <% if activity.parameters[:changed_fields].present? %>
                <span class="text-sm text-gray-500"><%= activity.parameters[:changed_fields].join(", ") %></span>
              <% end %>
            <% end %>
          </div>
          <span class="text-xs text-gray-400">
            <%= activity.owner&.email %> · <%= time_ago_in_words(activity.created_at) %> ago
          </span>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-gray-200 bg-white py-8 text-center">
    <p class="text-sm text-gray-400">No activity yet</p>
  </div>
<% end %>